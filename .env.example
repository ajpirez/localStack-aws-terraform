# Copia este archivo a .env y pega un Developer Auth Token.
# Plan Hobby (gratis, uso no comercial): https://app.localstack.cloud
# Tokens: https://app.localstack.cloud/workspace/auth-tokens
LOCALSTACK_AUTH_TOKEN=

DEBUG=0
# Persistencia de estado entre reinicios. En el plan Hobby puede no estar incluida.
PERSISTENCE=0
AWS_DEFAULT_REGION=us-east-1
